<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Demo Data Admin</label>
    <description>Full access to Demo Data custom object, loader Apex class, and admin tab.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <license>Salesforce</license>
    <classAccesses>
        <apexClass>DemoDataLoader</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <objectPermissions>
        <object>Demo_Data__c</object>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Demo_Data__c.Account__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Demo_Data__c.External_Key__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Demo_Data__c.Payload__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Demo_Data__c.Period__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Demo_Data__c.Subtype__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <tabSettings>
        <tab>AFLSCE_Demo_Data</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>First_and_Third_Party_Data</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
